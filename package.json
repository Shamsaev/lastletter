{
  "name": "last-letter",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"node --env-file-if-exists=.env --watch --import tsx src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx e2e/play.ts"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "word-list": "^4.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "private": true
}
