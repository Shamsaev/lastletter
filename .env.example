# Discord Developer Portal → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Developer Portal → Bot → Reset Token. Posts results to the voice channel text chat.
DISCORD_BOT_TOKEN=
# Daily all-time summary (local time in REPORT_TZ)
REPORT_TIME=23:59
REPORT_TZ=Europe/Moscow
# STATS_FILE=data/stats.json
# 1 = allow browser players without Discord (local testing). Default: on in dev, off in production.
# ALLOW_GUESTS=1
# PORT=3000
